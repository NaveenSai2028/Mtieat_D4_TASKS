import java.util.HashMap;

public class PhoneContactDirectory {
    public static void main(String[] args) {
        HashMap<String, String> contacts = new HashMap<>();

        // adding new contacts
        contacts.put("Naveen", "9876543210");
        contacts.put("Sai", "9123456780");
        contacts.put("Hari", "9988776655");
        contacts.put("Nikhil", "9000111222");
        contacts.put("Likhith", "9440012345");

        // updating existing phone number
        contacts.put("Sai", "9111222333");

        // search for a contact
        if (contacts.containsKey("Naveen")) {
            System.out.println("Naveen's Number: " + contacts.get("Naveen"));
        }

        // delete a contact
        contacts.remove("Hari");

        // display all contacts
        System.out.println(contacts);

        // check whether a particular phone number is already saved
        System.out.println("Is 9440012345 saved? " + contacts.containsValue("9440012345"));
    }
}
