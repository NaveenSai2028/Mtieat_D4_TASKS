import java.util.HashSet;

public class CollegeEventRegistration {
    public static void main(String[] args) {
        // 1. Store student registration IDs
        HashSet<Integer> event1 = new HashSet<>();

        // 2. Allow students to register for an event
        event1.add(101);
        event1.add(102);
        event1.add(103);
        event1.add(104);
        event1.add(105);

        // 3. Prevent duplicate registrations (automatically ignored by HashSet)
        event1.add(102);

        // 4. Remove a registration when a student cancels
        event1.remove(103);

        // 5. Search whether a student has registered
        System.out.println("Is ID 101 registered? " + event1.contains(101));

        // 6. Display all registered student IDs
        System.out.println("Event 1 Registered IDs: " + event1);

        // 7. Display total number of unique registrations
        System.out.println("Total Unique Registrations: " + event1.size());

        // 8. Accept registrations for two different events and identify common & all students
        HashSet<Integer> event2 = new HashSet<>();
        event2.add(104);
        event2.add(105);
        event2.add(106);
        event2.add(107);

        // Identify students registered for BOTH events using retainAll()
        HashSet<Integer> commonStudents = new HashSet<>(event1);
        commonStudents.retainAll(event2);
        System.out.println("Registered for Both Events: " + commonStudents);

        // Combine all unique students across both events using addAll()
        HashSet<Integer> allParticipants = new HashSet<>(event1);
        allParticipants.addAll(event2);
        System.out.println("All Unique Participants (Event 1 + Event 2): " + allParticipants);
    }
}
