import java.util.ArrayList;

public class StudentNameManagement {
    public static void main(String[] args) {
        ArrayList<String> list = new ArrayList<>();

        // adding 10 students
        list.add("Naveen");
        list.add("Sai");
        list.add("Hari");
        list.add("Nikhil");
        list.add("Likhith");
        list.add("Ganesh");
        list.add("Shiva");
        list.add("Vikram");
        list.add("Vijay");
        list.add("Dhanush");

        // display all
        System.out.println("Students list:");
        for (int i = 0; i < list.size(); i++) {
            System.out.println(list.get(i));
        }

        // add at specific position
        list.add(2, "Karthik");
        System.out.println("\nAfter adding Karthik: " + list);

        // remove by name
        list.remove("Hari");
        System.out.println("After removing Hari: " + list);

        // update at index
        list.set(3, "Nikhil K");
        System.out.println("After updating index 3: " + list);

        // search student
        System.out.println("Is Naveen present? " + list.contains("Naveen"));

        // total students
        System.out.println("Total students: " + list.size());
    }
}
