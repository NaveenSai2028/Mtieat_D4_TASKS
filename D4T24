import java.util.TreeSet;

public class OnlineCourseSkillManagement {
    public static void main(String[] args) {
        // 1. Store unique technical skills using TreeSet
        TreeSet<String> skills = new TreeSet<>();
        skills.add("Java");
        skills.add("Python");
        skills.add("React");
        skills.add("SQL");
        skills.add("MongoDB");

        // 2. Add new skills
        skills.add("Node.js");
        skills.add("Docker");

        // 3. Prevent duplicate skills (automatically ignored by TreeSet)
        skills.add("Java");

        // 4. Automatically arranged in alphabetical order
        System.out.println("Skills (Alphabetical Order): " + skills);

        // 5. Remove a skill that is no longer offered
        skills.remove("MongoDB");
        System.out.println("After removing MongoDB: " + skills);

        // 6. Search for a particular skill
        System.out.println("Is React offered? " + skills.contains("React"));

        // 7. Display the first and last skill alphabetically
        System.out.println("First Skill: " + skills.first());
        System.out.println("Last Skill: " + skills.last());

        // 8. Display skills in descending alphabetical order
        System.out.println("Skills (Descending Order): " + skills.descendingSet());
    }
}
