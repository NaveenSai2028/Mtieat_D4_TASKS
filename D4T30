import java.util.HashMap;
import java.util.Map;
import java.util.Scanner;

public class WordFrequencyCounter {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        // 1. Accept a paragraph from the user[span_0](start_span)[span_0](end_span)
        System.out.println("Enter a paragraph:");
        String paragraph = sc.nextLine();

        // 2. Convert all words to lowercase[span_1](start_span)[span_1](end_span)
        // 3. Remove punctuation marks[span_2](start_span)[span_2](end_span)
        String cleaned = paragraph.toLowerCase().replaceAll("[^a-z0-9\\s]", "");

        // 4. Split the paragraph into individual words[span_3](start_span)[span_3](end_span)
        String[] words = cleaned.trim().split("\\s+");

        // 5. Store each word as a key and its frequency as a value using HashMap[span_4](start_span)[span_4](end_span)
        HashMap<String, Integer> wordCount = new HashMap<>();
        for (String word : words) {
            if (!word.isEmpty()) {
                wordCount.put(word, wordCount.getOrDefault(word, 0) + 1);
            }
        }

        // 6. Display each word with its occurrence count & 7. Identify the most frequently occurring word[span_5](start_span)[span_5](end_span)
        String mostFrequentWord = "";
        int maxCount = 0;

        for (Map.Entry<String, Integer> entry : wordCount.entrySet()) {
            System.out.println(entry.getKey() + " : " + entry.getValue());
            if (entry.getValue() > maxCount) {
                maxCount = entry.getValue();
                mostFrequentWord = entry.getKey();
            }
        }

        // 8. Display the total number of unique words[span_6](start_span)[span_6](end_span)
        System.out.println("Unique Words: " + wordCount.size());
        System.out.println("Most Frequent Word: " + mostFrequentWord + " (" + maxCount + ")");

        sc.close();
    }
}
